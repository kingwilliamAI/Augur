# --- RPC ---------------------------------------------------------------------
# Logs endpoint. The official RPC is the only public one that serves eth_getLogs.
# Limits observed 2026-09-06: max 10,000 results per response, wide ranges time out, bursts get 429.
RPC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com

# State reads. publicnode is faster and more generous, but refuses eth_getLogs.
RPC_STATE_URL=https://robinhood-rpc.publicnode.com

# Push detection. The official endpoint has no websocket ("notifications not supported");
# publicnode does. Set to "off" to fall back to polling every POLL_MS.
RPC_WS_URL=wss://robinhood-rpc.publicnode.com
POLL_MS=300

# Politeness on the shared public endpoints. Raise these if you bring your own provider.
RPC_IN_FLIGHT=3
RPC_SPACING_MS=60
LOGS_CHUNK_BLOCKS=60000
LOGS_SPACING_MS=400

# --- storage -----------------------------------------------------------------
DB_PATH=./data/augur.db

# --- board -------------------------------------------------------------------
BOARD_PORT=4663
# Behind a reverse proxy, bind to loopback only and let the proxy be the front door:
#   BOARD_HOST=127.0.0.1
#   TRUST_PROXY=1
BOARD_HOST=0.0.0.0

# --- telegram ----------------------------------------------------------------
# Optional, and the only setting that makes this project talk to a third party.
# Create a bot with @BotFather, paste the token it gives you here, then: npm run telegram
# .env is git-ignored. Anyone holding this token controls the bot, so keep it off chats and commits.
TELEGRAM_BOT_TOKEN=

# --- the fee split -----------------------------------------------------------
# The contract that divides the curve fee three ways, once one is deployed: see
# contracts/FeeSplitter.sol and section 10 of DEPLOY.md. Empty means the fee still arrives at
# whatever wallet the launch named, and the fees page says so rather than describing a split that is
# not in force. The shares are not configured here on purpose: they are immutable in the contract,
# so the page reads them from it instead of from a file anybody could edit.
FEE_SPLITTER=

# --- splitting the fee in software -------------------------------------------
# The three wallets the fee is divided between, and their shares in basis points. All three shares
# ship at zero, so `npm run payout` refuses to run until somebody has decided them: a default here
# would be a number nobody chose, moving real money the first time the command was tried. The shares
# must add up to 10000 exactly, and the three addresses must be set and different from each other.
PAYOUT_NODES=
PAYOUT_BUYBACK=
PAYOUT_TEAM=
PAYOUT_NODES_BPS=0
PAYOUT_BUYBACK_BPS=0
PAYOUT_TEAM_BPS=0

# Left in the wallet so it can always pay for the next run's gas, and the floor below which a run is
# refused because three transfers would cost more than they move.
PAYOUT_RESERVE_ETH=0.01
PAYOUT_MIN_ETH=0.02

# Sending needs an endpoint that accepts eth_sendRawTransaction. Empty uses RPC_HTTP_URL.
PAYOUT_RPC_URL=

# The key that signs those three transfers, and the only key anywhere in this project.
#
# Leave it empty on every machine except the one that operates the fee wallet: without it the payout
# command still prints its plan and cannot send. Nothing else here reads it, and no part of the
# board, the bot or the scanner has a path to it. It is a hot key sitting in a file, so it should
# hold the fee wallet and nothing else, and .env should stay off backups that leave the machine.
PAYOUT_PRIVATE_KEY=

# --- holder tiers ------------------------------------------------------------
# What holding $AUGUR opens on a hosted instance, in whole tokens. Both at zero switches the paid
# half off entirely and every reader gets everything, which is the right setting for a local clone
# and for a hosted one whose thresholds are not decided yet.
TIER1_TOKENS=0
TIER2_TOKENS=0

# What a reader without the token gets: alerts this many seconds after the score is written, and
# nothing below this score. These two are the whole difference between the free bot and the paid one.
FREE_DELAY_SEC=60
FREE_MIN_SCORE=10

# A tier lost by selling comes back this long after the balance does, so it cannot be borrowed for
# the one minute an alert is worth. Balances are re-read on the second interval.
TIER_COOLDOWN_SEC=604800
TIER_RECHECK_SEC=3600

# The per-minute API limit for a request carrying a key from a holding wallet, against RATE_LIMIT
# for everyone else.
RATE_LIMIT_KEYED=2000

# Where the board answers, for the /link URL the bot hands out. The bot is a separate process and
# has no way to know the hostname it is reachable under, so it is told. Point it at the board:
# http://localhost:4663 for a local run.
SITE_URL=https://getaugur.xyz
